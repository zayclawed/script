local passed, total = 0, 0
local function test(name, fn)
    total = total + 1
    local success, result = pcall(fn)
    if success and result then
        passed = passed + 1
        print("✅ [PASS] " .. name)
    else
        warn("❌ [FAIL] " .. name .. (result and (": " .. tostring(result)) or ""))
    end
end

print("--- [ STARTING PC-SPECIFIC MASTER BENCHMARK ] ---")

-- 1. PC IDENTITY & VULNERABILITY
test("IdentifyExecutor (Returns Name)", function() return identifyexecutor() ~= nil end)
test("GetThreadIdentity (Permissions)", function() 
    local id = (getthreadidentity or get_thread_identity or syn.get_thread_identity)()
    return type(id) == "number"
end)
test("CheckCaller (Spoof Prevention)", function() return checkcaller() == true end)

-- 2. ADVANCED HOOKING (sUNC)
test("hookmetamethod (__namecall)", function()
    local old; old = hookmetamethod(game, "__namecall", function(self, ...) return old(self, ...) end)
    return old ~= nil
end)
test("hookfunction (Local Logic)", function()
    local function target() return "original" end
    local old; old = hookfunction(target, function() return "hooked" end)
    return target() == "hooked"
end)
test("newcclosure (Memory Masking)", function()
    local f = newcclosure(function() return "test" end)
    return iscclosure(f) == true
end)

-- 3. FULL FILESYSTEM (PC EXCLUSIVE PATHS)
test("writefile (Standard)", function() writefile("pc_test.txt", "pc_data") return true end)
test("readfile", function() return readfile("pc_test.txt") == "pc_data" end)
test("appendfile", function() appendfile("pc_test.txt", "_ext") return readfile("pc_test.txt") == "pc_data_ext" end)
test("makefolder/isfolder", function() makefolder("pc_folder") return isfolder("pc_folder") end)
test("listfiles (Deep Scan)", function() return type(listfiles("")) == "table" end)
test("loadfile (Executable Script)", function()
    writefile("pc_load.txt", "return 'loaded'")
    local f = loadfile("pc_load.txt")
    local res = f() == "loaded"
    delfile("pc_load.txt")
    return res
end)
test("delfile/delfolder", function() delfile("pc_test.txt") delfolder("pc_folder") return true end)

