local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "ROGUE PIECE | Developer Suite",
   LoadingTitle = "Loading Game Files...",
   LoadingSubtitle = "by Gemini",
   ConfigurationSaving = { Enabled = false }
})

-- Variables
local _G = {
    Farm = false,
    Magnet = false,
    SelectedNPC = "None",
    NPCList = {}
}

-- Function to scan game files for NPCs
local function getNPCs()
    local list = {}
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Model") and v:FindFirstChild("Humanoid") and v ~= game.Players.LocalPlayer.Character then
            if not table.find(list, v.Name) then
                table.insert(list, v.Name)
            end
        end
    end
    return list
end

local MainTab = Window:CreateTab("Combat & Farm", 4483362458) -- Tab Icon

-- 1. DROPDOWN: Target Selection
local NPCDropdown = MainTab:CreateDropdown({
   Name = "Select Target NPC",
   Options = getNPCs(),
   CurrentOption = {"None"},
   MultipleOptions = false,
   Callback = function(Option)
      _G.SelectedNPC = Option[1]
   end,
})

-- Refresh Button (In case new NPCs spawn)
MainTab:CreateButton({
   Name = "Refresh NPC List",
   Callback = function()
       NPCDropdown:Refresh(getNPCs())
   end,
})

-- 2. TOGGLE: Auto Farm
MainTab:CreateToggle({
   Name = "Auto Farm (Teleport)",
   CurrentValue = false,
   Callback = function(Value)
      _G.Farm = Value
      task.spawn(function()
          while _G.Farm do
              pcall(function()
                  local char = game.Players.LocalPlayer.Character
                  for _, v in pairs(workspace:GetDescendants()) do
                      if v.Name == _G.SelectedNPC and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
                          char.HumanoidRootPart.CFrame = v.HumanoidRootPart.CFrame * CFrame.new(0, 0, 4)
                          local tool = char:FindFirstChildOfClass("Tool")
                          if tool then tool:Activate() end
                      end
                  end
              end)
              task.wait(0.1)
          end
      end)
   end,
})

-- 3. TOGGLE: Mob Magnet
MainTab:CreateToggle({
   Name = "Mob Magnet (Sticky)",
   CurrentValue = false,
   Callback = function(Value)
      _G.Magnet = Value
      task.spawn(function()
          while _G.Magnet do
              pcall(function()
                  local root = game.Players.LocalPlayer.Character.HumanoidRootPart
                  for _, v in pairs(workspace:GetDescendants()) do
                      if v.Name == _G.SelectedNPC and v:FindFirstChild("HumanoidRootPart") then
                          v.HumanoidRootPart.CFrame = root.CFrame * CFrame.new(0, 0, -5)
                          v.HumanoidRootPart.Velocity = Vector3.new(0,0,0)
                      end
                  end
              end)
              task.wait()
          end
      end)
   end,
})

local VisualsTab = Window:CreateTab("Visuals & World", 4483362458)

-- 4. BUTTON: NPC ESP
VisualsTab:CreateButton({
   Name = "Enable NPC Highlight (ESP)",
   Callback = function()
       for _, v in pairs(workspace:GetDescendants()) do
           if v:IsA("Model") and v:FindFirstChild("Humanoid") and v ~= game.Players.LocalPlayer.Character then
               local h = Instance.new("Highlight", v)
               h.FillColor = Color3.fromRGB(255, 0, 0)
           end
       end
   end,
})

-- 5. BUTTON: Find Quest NPCs
VisualsTab:CreateButton({
   Name = "Mark Quest NPCs",
   Callback = function()
       for _, v in pairs(workspace:GetDescendants()) do
           if v:IsA("Model") and (v.Name:find("Quest") or v.Name:find("Giver")) then
               local h = Instance.new("Highlight", v)
               h.FillColor = Color3.fromRGB(0, 255, 255)
           end
       end
   end,
})
