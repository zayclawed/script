local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "ROGUE PIECE | Debug Menu",
   LoadingTitle = "Analyzing Game Files...",
   LoadingSubtitle = "by Gemini (Dev Suite)",
   ConfigurationSaving = { Enabled = false }
})

-- Variables for Loops
local _G = {
    AutoFarm = false,
    AutoStats = false,
    SelectedStat = "Melee", -- Default
    SelectedNPC = nil,
    Distance = 5
}

-- Functions to fetch data from your game
local function getNPCs()
    local tbl = {}
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Model") and v:FindFirstChild("Humanoid") and v.Name ~= game.Players.LocalPlayer.Name then
            if not table.find(tbl, v.Name) then table.insert(tbl, v.Name) end
        end
    end
    return tbl
end

local MainTab = Window:CreateTab("Main Farm", 4483362458)

MainTab:CreateDropdown({
   Name = "Select Mob to Farm",
   Options = getNPCs(),
   CurrentOption = {"None"},
   Callback = function(Option)
      _G.SelectedNPC = Option[1]
   end,
})

MainTab:CreateToggle({
   Name = "Auto Farm Target",
   CurrentValue = false,
   Callback = function(Value)
      _G.AutoFarm = Value
      task.spawn(function()
          while _G.AutoFarm do
              pcall(function()
                  local char = game.Players.LocalPlayer.Character
                  for _, v in pairs(workspace:GetDescendants()) do
                      if v.Name == _G.SelectedNPC and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
                          -- Teleporting to NPC
                          char.HumanoidRootPart.CFrame = v.HumanoidRootPart.CFrame * CFrame.new(0, 0, _G.Distance)
                          
                          -- Auto Click/Attack
                          local tool = char:FindFirstChildOfClass("Tool")
                          if tool then tool:Activate() end
                      end
                  end
              end)
              task.wait()
          end
      end)
   end,
})

local StatsTab = Window:CreateTab("Auto Stats", 4483362458)

StatsTab:CreateDropdown({
   Name = "Select Stat",
   Options = {"Melee", "Defense", "Sword", "Devil Fruit"},
   CurrentOption = {"Melee"},
   Callback = function(Option)
      _G.SelectedStat = Option[1]
   end,
})

StatsTab:CreateToggle({
   Name = "Auto-Add Points",
   CurrentValue = false,
   Callback = function(Value)
      _G.AutoStats = Value
      task.spawn(function()
          while _G.AutoStats do
              -- This looks for a RemoteEvent typically named 'AddStat' or 'StatUpdate'
              -- You will need to find the exact name in your ReplicatedStorage
              local remote = game:GetService("ReplicatedStorage"):FindFirstChild("StatRemote", true) 
              if remote then
                  remote:InvokeServer(_G.SelectedStat, 1) -- Spends 1 point
              end
              task.wait(0.5)
          end
      end)
   end,
})

local MiscTab = Window:CreateTab("Misc", 4483362458)

MiscTab:CreateSlider({
   Name = "Farm Distance",
   Range = {1, 15},
   Increment = 1,
   CurrentValue = 5,
   Callback = function(Value)
      _G.Distance = Value
   end,
})

MiscTab:CreateButton({
   Name = "Destroy UI",
   Callback = function()
       Rayfield:Destroy()
   end,
})
